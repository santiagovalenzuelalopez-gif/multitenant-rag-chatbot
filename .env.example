# --- Observabilidad ---
SERVICE_NAME=multitenant-rag-chatbot
SERVICE_VERSION=1.0.0
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Backends (demo por defecto: sin credenciales ni red) ---
TENANT_BACKEND=filesystem      # filesystem | firestore
LLM_BACKEND=mock               # mock | gemini
TENANTS_DIR=data/tenants
TENANT_CACHE_TTL_SECONDS=90

# --- Producción (requirements-gcp.txt) ---
GCP_PROJECT=
GEMINI_API_KEY=                # inyectar desde un gestor de secretos; nunca versionar
GEMINI_MODEL=gemini-2.5-flash

# --- Herramientas ---
TICKETS_API_URL=               # vacío = datos sintéticos de demo
TOOL_LOOP_BUDGET_SECONDS=20
